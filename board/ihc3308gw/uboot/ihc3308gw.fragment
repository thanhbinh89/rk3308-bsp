# Overlay on configs/roc-cc-rk3308_defconfig at the pinned commit.
# Keep the reference board implementation; own the board configuration and DT.
# CONFIG_OF_UPSTREAM is not set
CONFIG_DEFAULT_DEVICE_TREE="rk3308-ihc3308gw"
CONFIG_DEFAULT_FDT_FILE="rockchip/rk3308b-roc-cc-plus-amic-ext_emmc.dtb"
CONFIG_DEBUG_UART_BASE=0xFF0E0000
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_DEBUG_UART_SHIFT=2
CONFIG_DEBUG_UART_BOARD_INIT=y
CONFIG_BAUDRATE=1500000
CONFIG_ROCKCHIP_EXTERNAL_TPL=y
CONFIG_SPL_ATF=y
CONFIG_SPL_LOAD_FIT=y
CONFIG_LOCALVERSION="-epcb-ihc3308gw-lab3"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_BOOTDELAY=-1
CONFIG_CMD_BDI=y
CONFIG_CMD_BOOTI=y
CONFIG_CMD_FDT=y
CONFIG_CMD_TFTPBOOT=y
CONFIG_CMD_PING=y
CONFIG_SYS_MMCSD_RAW_MODE_U_BOOT_SECTOR=0x2000
CONFIG_SPL_PAD_TO=0x3f8000
